{
  "openapi": "3.1.0",
  "info": {
    "title": "MAX Marketing REST API",
    "version": "1.0.0",
    "description": "API всех существующих разделов MAX Marketing. Пути /api сохраняются как в интерфейсе. Для пользовательских методов: Authorization: Bearer mmk_… (или JWT). Административные методы требуют отдельный admin JWT; вебхуки и публичные методы имеют свой протокол. API-ключи не дают дополнительных прав или бесплатных генераций. x-source-fields — подсказки из legacy-кода, НЕ полная типизированная схема. Публикации/рассылки/оплаты выполняют реальные действия: не повторяйте POST автоматически."
  },
  "paths": {
    "/api/modules/{tracking_code}": {
      "get": {
        "summary": "Get Module Settings",
        "description": "Get enabled modules for a channel.",
        "operationId": "get_api_modules_tracking_code",
        "parameters": [
          {
            "name": "tracking_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tracking Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "modules"
        ],
        "x-access": "custom-or-public",
        "x-source-fields": {},
        "x-handler": "app.main.get_module_settings"
      }
    },
    "/api/modules/{tracking_code}/{module_type}": {
      "put": {
        "summary": "Toggle Module",
        "description": "Enable/disable a module for a channel.\n\nLegacy-body: перечислены непосредственно читаемые поля. Вложенные структуры, условная обязательность и динамические поля могут требовать сверки с обработчиком. В multipart объекты и массивы передаются JSON-строками, файлы — binary.",
        "operationId": "put_api_modules_tracking_code_module_type",
        "parameters": [
          {
            "name": "tracking_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tracking Code"
            }
          },
          {
            "name": "module_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Module Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "modules"
        ],
        "x-access": "custom-or-public",
        "x-source-fields": {
          "application/json": [
            "config",
            "is_enabled"
          ]
        },
        "x-handler": "app.main.toggle_module",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "config": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "is_enabled": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-ключ mmk_… либо пользовательский JWT"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только JWT администратора платформы"
      },
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только пользовательский JWT после входа; API-ключ не подходит"
      },
      "MetricsKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Отдельный служебный METRICS_API_KEY"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "modules",
      "description": "Модули канала"
    }
  ]
}
