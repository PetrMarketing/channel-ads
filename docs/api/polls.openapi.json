                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-access": "custom-or-public",
        "x-source-fields": {
          "application/json": [
            "name",
            "option_id",
            "platform",
            "uid",
            "username"
          ]
        },
        "x-handler": "app.routes.polls.public_vote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
