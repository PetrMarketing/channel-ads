{
  "openapi": "3.1.0",
  "info": {
    "title": "MAX Marketing REST API",
    "version": "1.0.0",
    "description": "API всех существующих разделов MAX Marketing. Пути /api сохраняются как в интерфейсе. Для пользовательских методов: Authorization: Bearer mmk_… (или JWT). Административные методы требуют отдельный admin JWT; вебхуки и публичные методы имеют свой протокол. API-ключи не дают дополнительных прав или бесплатных генераций. x-source-fields — подсказки из legacy-кода, НЕ полная типизированная схема. Публикации/рассылки/оплаты выполняют реальные действия: не повторяйте POST автоматически."
  },
  "paths": {
    "/api/support/topics": {
      "get": {
        "tags": [
          "support"
        ],
        "summary": "Get Support Topics",
        "description": "Возвращает всё древо тем разом — фронт хранит локально и навигирует\nбез лишних запросов.",
        "operationId": "get_api_support_topics",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "x-access": "custom-or-public",
        "x-source-fields": {},
        "x-handler": "app.routes.support.get_support_topics"
      }
    },
    "/api/support/operator-request": {
      "post": {
        "tags": [
          "support"
        ],
        "summary": "Operator Request",
        "description": "Пользователь нажал «Позвать оператора» и описал проблему.\nСоздаём (или переиспользуем) тикет, добавляем сообщение с контекстом\nвыбранной темы, помечаем escalated. Админ увидит в /admin/support.\n\nLegacy-body: перечислены непосредственно читаемые поля. Вложенные структуры, условная обязательность и динамические поля могут требовать сверки с обработчиком. В multipart объекты и массивы передаются JSON-строками, файлы — binary.",
        "operationId": "post_api_support_operator_request",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "UserBearer": []
          }
        ],
        "x-access": "user",
        "x-source-fields": {
          "application/json": [
            "description",
            "topic_id"
          ]
        },
        "x-handler": "app.routes.support.operator_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "description": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "topic_id": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  }
                }
              }
            }
          }
        }
      }
    },
