    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-ключ mmk_… либо пользовательский JWT"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только JWT администратора платформы"
      },
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только пользовательский JWT после входа; API-ключ не подходит"
      },
      "MetricsKey": {
        "type": "apiKey",
        "in": "header",
