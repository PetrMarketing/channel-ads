        "scheme": "bearer",
        "description": "Только JWT администратора платформы"
      },
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только пользовательский JWT после входа; API-ключ не подходит"
      },
      "MetricsKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Отдельный служебный METRICS_API_KEY"
