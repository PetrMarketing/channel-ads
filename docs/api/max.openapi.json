        "x-access": "user",
        "x-source-fields": {},
        "x-handler": "app.routes.max_routes.refresh_chat_info"
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-ключ mmk_… либо пользовательский JWT"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только JWT администратора платформы"
      },
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только пользовательский JWT после входа; API-ключ не подходит"
      },
      "MetricsKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Отдельный служебный METRICS_API_KEY"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "max",
      "description": "Подключение MAX"
    }
  ]
}
