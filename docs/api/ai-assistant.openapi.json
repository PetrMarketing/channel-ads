{
  "openapi": "3.1.0",
  "info": {
    "title": "MAX Marketing REST API",
    "version": "1.0.0",
    "description": "API всех существующих разделов MAX Marketing. Пути /api сохраняются как в интерфейсе. Для пользовательских методов: Authorization: Bearer mmk_… (или JWT). Административные методы требуют отдельный admin JWT; вебхуки и публичные методы имеют свой протокол. API-ключи не дают дополнительных прав или бесплатных генераций. x-source-fields — подсказки из legacy-кода, НЕ полная типизированная схема. Публикации/рассылки/оплаты выполняют реальные действия: не повторяйте POST автоматически."
  },
  "paths": {
    "/api/ai-assistant/parse": {
      "post": {
        "tags": [
          "ai-assistant"
        ],
        "summary": "Parse Query",
        "operationId": "post_api_ai_assistant_parse",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "UserBearer": []
          }
        ],
        "x-access": "user",
        "x-source-fields": {
          "application/json": [
            "query",
            "tracking_code"
          ]
        },
        "x-handler": "app.routes.ai_assistant.parse_query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "query": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "tracking_code": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  }
                }
              }
            }
          }
        },
        "description": "Legacy-body: перечислены непосредственно читаемые поля. Вложенные структуры, условная обязательность и динамические поля могут требовать сверки с обработчиком. В multipart объекты и массивы передаются JSON-строками, файлы — binary."
      }
    },
    "/api/ai-assistant/{task_id}/answer": {
      "post": {
        "tags": [
          "ai-assistant"
        ],
        "summary": "Submit Answers",
        "description": "Юзер отвечает на уточняющие вопросы. Мы склеиваем ответы с оригинальным\nзапросом и заново гоним через LLM. Токен за parse не списываем повторно —\nэто часть той же изначальной задачи.\n\nLegacy-body: перечислены непосредственно читаемые поля. Вложенные структуры, условная обязательность и динамические поля могут требовать сверки с обработчиком. В multipart объекты и массивы передаются JSON-строками, файлы — binary.",
        "operationId": "post_api_ai_assistant_task_id_answer",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-access": "user",
        "x-source-fields": {
          "application/json": [
            "answers"
          ]
        },
        "x-handler": "app.routes.ai_assistant.submit_answers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "answers": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai-assistant/{task_id}/confirm": {
      "post": {
        "tags": [
          "ai-assistant"
        ],
        "summary": "Confirm Task",
        "operationId": "post_api_ai_assistant_task_id_confirm",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-access": "user",
        "x-source-fields": {},
        "x-handler": "app.routes.ai_assistant.confirm_task"
      }
    },
    "/api/ai-assistant/tasks": {
      "get": {
        "tags": [
          "ai-assistant"
        ],
        "summary": "List Tasks",
        "operationId": "get_api_ai_assistant_tasks",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "tracking_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Tracking Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-access": "user",
        "x-source-fields": {},
        "x-handler": "app.routes.ai_assistant.list_tasks"
      }
    },
    "/api/ai-assistant/{task_id}": {
      "get": {
        "tags": [
          "ai-assistant"
        ],
        "summary": "Get Task",
        "operationId": "get_api_ai_assistant_task_id",
        "security": [
          {
            "UserBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-access": "user",
        "x-source-fields": {},
        "x-handler": "app.routes.ai_assistant.get_task"
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-ключ mmk_… либо пользовательский JWT"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только JWT администратора платформы"
      },
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только пользовательский JWT после входа; API-ключ не подходит"
      },
      "MetricsKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Отдельный служебный METRICS_API_KEY"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "ai-assistant",
      "description": "ИИ-помощник"
    }
  ]
}
