    "/api/track/visit/{visit_id}/await-subscription": {
      "post": {
        "tags": [
          "track"
        ],
        "summary": "Await Subscription",
        "description": "Called from SubscribePage on click 'Перейти в канал'.\nCreates a pending_conversion that will fire YM/VK goals if a real\nsubscription arrives within 60 seconds.",
        "operationId": "post_api_track_visit_visit_id_await_subscription",
        "parameters": [
          {
            "name": "visit_id",
            "in": "path",
            "required": true,
