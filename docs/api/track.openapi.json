{
  "openapi": "3.1.0",
  "info": {
    "title": "MAX Marketing REST API",
    "version": "1.0.0",
    "description": "API всех существующих разделов MAX Marketing. Пути /api сохраняются как в интерфейсе. Для пользовательских методов: Authorization: Bearer mmk_… (или JWT). Административные методы требуют отдельный admin JWT; вебхуки и публичные методы имеют свой протокол. API-ключи не дают дополнительных прав или бесплатных генераций. x-source-fields — подсказки из legacy-кода, НЕ полная типизированная схема. Публикации/рассылки/оплаты выполняют реальные действия: не повторяйте POST автоматически."
  },
  "paths": {
    "/api/track/miniapp-visit": {
      "post": {
        "tags": [
          "track"
        ],
        "summary": "Miniapp Visit",
        "description": "Record visit from MAX Mini App and return channel info + URL.\n\nAccepts max_user_id, init_data, ym_client_id and stores them on the visit\nso the resulting subscription can be properly attributed (full miniapp\ndeep-link flow → server-side pixel firing).\n\nLegacy-body: перечислены непосредственно читаемые поля. Вложенные структуры, условная обязательность и динамические поля могут требовать сверки с обработчиком. В multipart объекты и массивы передаются JSON-строками, файлы — binary.",
        "operationId": "post_api_track_miniapp_visit",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "x-access": "custom-or-public",
        "x-source-fields": {
          "application/json": [
            "code",
            "init_data",
            "max_user_id",
            "page_url",
            "ym_client_id"
          ]
        },
        "x-handler": "app.routes.tracking.miniapp_visit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "code": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "init_data": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "max_user_id": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "page_url": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  },
                  "ym_client_id": {
                    "description": "Поле legacy-обработчика; тип и обязательность проверяет сервер."
                  }
                }
              }
            }
          }
        }
      }
    },
