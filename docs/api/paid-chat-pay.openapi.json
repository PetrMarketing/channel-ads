              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-access": "custom-or-public",
        "x-source-fields": {
          "application/json": [
            "email",
            "first_name",
            "max_user_id",
            "paid_chat_id",
            "phone",
            "plan_id",
